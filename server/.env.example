# ==========================================
# MediBridge Backend Configuration
# ==========================================
PORT=5000

# MongoDB URI (Leave empty or default to use built-in automatic mongodb-memory-server)
MONGO_URI=mongodb://localhost:27017/medibridge

# JWT Authentication Secrets
JWT_SECRET=medibridge_production_secret_key_hackathon_2026
JWT_REFRESH_SECRET=medibridge_refresh_secret_key_hackathon_2026

# Allowed Frontend Client URL (CORS)
CLIENT_URL=http://localhost:5173

# ML Prediction Service (Optional Flask model API)
MODEL_API_URL=http://localhost:5001

# Cloud Storage (Optional Cloudinary config; local fallback active)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Grok / Groq Fast AI Clinical Summarizer
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
XAI_API_KEY=

# Hugging Face Clinical Diagnostic Copilot
HF_API_TOKEN=
HF_DIAGNOSIS_MODEL=emilyalsentzer/Bio_ClinicalBERT
HF_FALLBACK_MODEL=qwen/qwen3.8-27b

# EvidenceScribe configuration. Copy to .env (loaded automatically; real env vars win).
# With nothing set, the app runs in DEMO mode: no keys, no network.
# Model names and URLs have NO defaults on purpose - set them for live mode.

# ---- Speech recognition -------------------------------------------------
ASR_PROVIDER=demo                 # demo | openai_compatible | faster_whisper
ASR_BASE_URL=                     # e.g. https://api.openai.com/v1 (POSTs to {ASR_BASE_URL}/audio/transcriptions)
ASR_API_KEY=
ASR_MODEL=                        # a model your server supports with verbose_json + word timestamps
ASR_LANGUAGE=                     # optional ISO code, e.g. en or hi
FASTER_WHISPER_MODEL=             # e.g. a faster-whisper model size or local path
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8

# ---- LLMs ---------------------------------------------------------------
LLM_PROVIDER=demo                 # demo | anthropic | openai_compatible   (GENERATOR role)
VERIFIER_PROVIDER=                # defaults to LLM_PROVIDER; prefer a different model family
GENERATOR_MODEL=
VERIFIER_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
LLM_BASE_URL=                     # OpenAI-compatible server for the generator (POST {LLM_BASE_URL}/chat/completions)
LLM_API_KEY=
VERIFIER_BASE_URL=                # OpenAI-compatible server for the verifier (if VERIFIER_PROVIDER=openai_compatible)
VERIFIER_API_KEY=
LLM_JSON_MODE=json_object         # response_format type sent to OpenAI-compatible servers
LLM_MAX_TOKENS=4096
LLM_RETRIES=3                     # 1..3 network retries with backoff
STAGE_TIMEOUT_S=90
DEMO_REPLAY=0                     # 1 = serve only cached outputs, never call the network

# ---- Pipeline tuning ----------------------------------------------------
UTTERANCE_PAUSE_MS=500            # pause that splits utterances
ROLE_CONF_MIN=0.6                 # below this a speaker label becomes "unknown" + flag
REPAIR_THRESHOLD=0.80             # drug-name repair: minimum similarity
REPAIR_MARGIN=0.12                # ...and minimum lead over the runner-up, else flag ambiguous
CHANNEL_ROLES=                    # stereo recordings: e.g. doctor,patient (left,right channel)
READABILITY_MIN=4.0               # patient summary Flesch-Kincaid grade range
READABILITY_MAX=9.0

# ---- Data, privacy, sharing --------------------------------------------
DATA_DIR=                         # default ./data next to app.py
AUDIO_RETENTION_HOURS=            # delete audio this many hours after sign-off (empty = keep)
SHARE_TTL_HOURS=24
SHARE_MAX_ATTEMPTS=5              # wrong PINs before a share link locks
EVAL_RUNS=3                       # live eval repeats per consult

# ---- Server -------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

{"output": {"utterances": [{"id": "U01", "start_ms": 1500, "end_ms": 4576, "word_start": 0, "word_end": 8, "text": "Good morning Mr. Kumar, please have a seat.", "role": "doctor", "role_confidence": 0.97, "phase": "small_talk", "flags": [], "role_source": "llm"}, {"id": "U02", "start_ms": 5226, "end_ms": 11008, "word_start": 8, "word_end": 22, "text": "Good morning doctor. Arre, the traffic was terrible today, one hour from Sector 22.", "role": "patient", "role_confidence": 0.95, "phase": "small_talk", "flags": [], "role_source": "llm"}, {"id": "U03", "start_ms": 11795, "end_ms": 14651, "word_start": 22, "word_end": 29, "text": "Everyone is out after the cricket match.", "role": "doctor", "role_confidence": 0.93, "phase": "small_talk", "flags": [], "role_source": "llm"}, {"id": "U04", "start_ms": 15575, "end_ms": 17749, "word_start": 29, "word_end": 35, "text": "So, what brings you in today?", "role": "doctor", "role_confidence": 0.96, "phase": "history", "flags": [], "role_source": "llm"}, {"id": "U05", "start_ms": 18410, "end_ms": 23090, "word_start": 35, "word_end": 48, "text": "I have had a cough for about two weeks, and fever at night.", "role": "patient", "role_confidence": 0.97, "phase": "history", "flags": [], "role_source": "llm"}, {"id": "U06", "start_ms": 23888, "end_ms": 27572, "word_start": 48, "word_end": 58, "text": "Is the cough dry, or are you bringing up phlegm?", "role": "doctor", "role_confidence": 0.96, "phase": "history", "flags": [], "role_source": "llm"}, {"id": "U07", "start_ms": 28507, "end_ms": 32737, "word_start": 58, "word_end": 68, "text": "Mostly dry, but sometimes thoda yellow phlegm in the morning.", "role": "patient", "role_confidence": 0.96, "phase": "history", "flags": [], "role_source": "llm"}, {"id": "U08", "start_ms": 33409, "end_ms": 35615, "word_start": 68, "word_end": 73, "text": "Any chest pain or breathlessness?", "role": "doctor", "role_confidence": 0.97, "phase": "history", "flags": [], "role_source": "llm"}, {"id": "U09", "start_ms": 36424, "end_ms": 41356, "word_start": 73, "word_end": 86, "text": "No chest pain. But I get a little breathless when I climb stairs.", "role": "patient", "role_confidence": 0.97, "phase": "history", "flags": [], "role_source": "llm"}, {"id": "U10", "start_ms": 42302, "end_ms": 44130, "word_start": 86, "word_end": 91, "text": "Any blood in the phlegm?", "role": "doctor", "role_confidence": 0.96, "phase": "history", "flags": [], "role_source": "llm"}, {"id": "U11", "start_ms": 44813, "end_ms": 45781, "word_start": 91, "word_end": 94, "text": "No, no blood.", "role": "patient", "role_confidence": 0.94, "phase": "history", "flags": [], "role_source": "llm"}, {"id": "U12", "start_ms": 46601, "end_ms": 48775, "word_start": 94, "word_end": 100, "text": "How high has the fever been?", "role": "doctor", "role_confidence": 0.96, "phase": "history", "flags": [], "role_source": "llm"}, {"id": "U13", "start_ms": 49732, "end_ms": 52556, "word_start": 100, "word_end": 108, "text": "I checked once at home, it was 100.8.", "role": "patient", "role_confidence": 0.95, "phase": "history", "flags": [], "role_source": "llm"}, {"id": "U14", "start_ms": 53250, "end_ms": 56484, "word_start": 108, "word_end": 115, "text": "Are you taking your diabetes medicines regularly?", "role": "doctor", "role_confidence": 0.96, "phase": "history", "flags": [], "role_source": "llm"}, {"id": "U15", "start_ms": 57315, "end_ms": 63349, "word_start": 115, "word_end": 129, "text": "Actually doctor, I stopped the metformin last week because it was upsetting my stomach.", "role": "patient", "role_confidence": 0.97, "phase": "history", "flags": [], "role_source": "llm"}, {"id": "U16", "start_ms": 64317, "end_ms": 66009, "word_start": 129, "word_end": 133, "text": "Okay. Any other medicines?", "role": "doctor", "role_confidence": 0.95, "phase": "history", "flags": [], "role_source": "llm"}, {"id": "U17", "start_ms": 66714, "end_ms": 70556, "word_start": 133, "word_end": 142, "text": "Only the amlodipine every morning, that I am continuing.", "role": "patient", "role_confidence": 0.95, "phase": "history", "flags": [], "role_source": "llm"}, {"id": "U18", "start_ms": 71398, "end_ms": 73174, "word_start": 142, "word_end": 146, "text": "Any allergies to medicines?", "role": "doctor", "role_confidence": 0.96, "phase": "history", "flags": [], "role_source": "llm"}, {"id": "U19", "start_ms": 74153, "end_ms": 79179, "word_start": 146, "word_end": 160, "text": "Yes, I am allergic to penicillin. I got a rash all over my body.", "role": "patient", "role_confidence": 0.97, "phase": "history", "flags": [], "role_source": "llm"}, {"id": "U20", "start_ms": 79895, "end_ms": 84041, "word_start": 160, "word_end": 170, "text": "Does anyone in the family have diabetes or heart problems?", "role": "doctor", "role_confidence": 0.96, "phase": "history", "flags": [], "role_source": "llm"}, {"id": "U21", "start_ms": 84894, "end_ms": 89742, "word_start": 170, "word_end": 183, "text": "My mother had diabetes, and my father had a heart attack at 60.", "role": "patient", "role_confidence": 0.96, "phase": "history", "flags": [], "role_source": "llm"}, {"id": "U22", "start_ms": 90732, "end_ms": 92476, "word_start": 183, "word_end": 188, "text": "Do you smoke or drink?", "role": "doctor", "role_confidence": 0.96, "phase": "history", "flags": [], "role_source": "llm"}, {"id": "U23", "start_ms": 93203, "end_ms": 97369, "word_start": 188, "word_end": 200, "text": "I used to smoke, but I quit 5 years ago. No alcohol.", "role": "patient", "role_confidence": 0.96, "phase": "history", "flags": [], "role_source": "llm"}, {"id": "U24", "start_ms": 98233, "end_ms": 102651, "word_start": 200, "word_end": 212, "text": "Doctor, he still eats a lot of sweets, I keep telling him.", "role": "family", "role_confidence": 0.81, "phase": "history", "flags": [], "role_source": "llm"}, {"id": "U25", "start_ms": 103652, "end_ms": 107462, "word_start": 212, "word_end": 222, "text": "Okay, let me examine you. Please take a deep breath.", "role": "doctor", "role_confidence": 0.95, "phase": "exam", "flags": [], "role_source": "llm"}, {"id": "U26", "start_ms": 108200, "end_ms": 112356, "word_start": 222, "word_end": 233, "text": "I can hear some crackles at the right lower lung base.", "role": "doctor", "role_confidence": 0.97, "phase": "exam", "flags": [], "role_source": "llm"}, {"id": "U27", "start_ms": 113231, "end_ms": 117167, "word_start": 233, "word_end": 243, "text": "Temperature is 99.4, and blood pressure is 138 over 86.", "role": "doctor", "role_confidence": 0.97, "phase": "exam", "flags": [], "role_source": "llm"}, {"id": "U28", "start_ms": 118179, "end_ms": 120343, "word_start": 243, "word_end": 248, "text": "Oxygen saturation is 96 percent.", "role": "doctor", "role_confidence": 0.97, "phase": "exam", "flags": [], "role_source": "llm"}, {"id": "U29", "start_ms": 121092, "end_ms": 127304, "word_start": 248, "word_end": 263, "text": "Mr. Kumar, this looks like a chest infection, possibly early pneumonia on the right side.", "role": "doctor", "role_confidence": 0.96, "phase": "assessment", "flags": [], "role_source": "llm"}, {"id": "U30", "start_ms": 128190, "end_ms": 133154, "word_start": 263, "word_end": 275, "text": "Since you are allergic to penicillin, I will not give you amoxicillin.", "role": "doctor", "role_confidence": 0.96, "phase": "plan", "flags": [], "role_source": "llm"}, {"id": "U31", "start_ms": 134177, "end_ms": 139571, "word_start": 275, "word_end": 288, "text": "I am starting azithromycin 500 milligrams once daily for 5 days, after food.", "role": "doctor", "role_confidence": 0.97, "phase": "plan", "flags": [], "role_source": "llm"}, {"id": "U32", "start_ms": 140331, "end_ms": 146983, "word_start": 288, "word_end": 305, "text": "If the fever goes above 102, take paracetamol 650 milligrams, not more than 3 times a day.", "role": "doctor", "role_confidence": 0.97, "phase": "plan", "flags": [], "role_source": "llm"}, {"id": "U33", "start_ms": 147880, "end_ms": 152550, "word_start": 305, "word_end": 317, "text": "Please get a chest X-ray and a complete blood count done today.", "role": "doctor", "role_confidence": 0.97, "phase": "plan", "flags": [], "role_source": "llm"}, {"id": "U34", "start_ms": 153584, "end_ms": 158086, "word_start": 317, "word_end": 329, "text": "Also an HbA1c test, to see how your sugar control has been.", "role": "doctor", "role_confidence": 0.96, "phase": "plan", "flags": [], "role_source": "llm"}, {"id": "U35", "start_ms": 158857, "end_ms": 166569, "word_start": 329, "word_end": 347, "text": "For the stomach upset, I am switching you to metformin extended release 500 milligrams once daily with dinner.", "role": "doctor", "role_confidence": 0.96, "phase": "plan", "flags": [], "role_source": "llm"}, {"id": "U36", "start_ms": 167477, "end_ms": 171319, "word_start": 347, "word_end": 356, "text": "Doctor, will this cough medicine affect my sugar levels?", "role": "patient", "role_confidence": 0.93, "phase": "counseling", "flags": [], "role_source": "llm"}, {"id": "U37", "start_ms": 172364, "end_ms": 175482, "word_start": 356, "word_end": 364, "text": "Drink plenty of warm fluids and take rest.", "role": "doctor", "role_confidence": 0.96, "phase": "counseling", "flags": [], "role_source": "llm"}, {"id": "U38", "start_ms": 176264, "end_ms": 185118, "word_start": 364, "word_end": 387, "text": "If you feel very breathless, or the fever does not come down in 3 days, come back immediately or go to the emergency.", "role": "doctor", "role_confidence": 0.96, "phase": "counseling", "flags": [], "role_source": "llm"}, {"id": "U39", "start_ms": 186037, "end_ms": 190025, "word_start": 387, "word_end": 398, "text": "Come back to see me after 1 week with the reports.", "role": "doctor", "role_confidence": 0.96, "phase": "plan", "flags": [], "role_source": "llm"}, {"id": "U40", "start_ms": 190681, "end_ms": 194973, "word_start": 398, "word_end": 410, "text": "Okay doctor. Kal se office jaana hai, can I go to work?", "role": "patient", "role_confidence": 0.94, "phase": "counseling", "flags": [], "role_source": "llm"}, {"id": "U41", "start_ms": 195766, "end_ms": 200362, "word_start": 410, "word_end": 423, "text": "Better to rest for 2 days, then you can go to the office.", "role": "doctor", "role_confidence": 0.95, "phase": "counseling", "flags": [], "role_source": "llm"}, {"id": "U42", "start_ms": 201292, "end_ms": 204012, "word_start": 423, "word_end": 429, "text": "Doctor, should he avoid sweets completely?", "role": "family", "role_confidence": 0.78, "phase": "counseling", "flags": [], "role_source": "llm"}, {"id": "U43", "start_ms": 204679, "end_ms": 207787, "word_start": 429, "word_end": 436, "text": "Yes, avoid sweets and sugary drinks completely.", "role": "doctor", "role_confidence": 0.95, "phase": "counseling", "flags": [], "role_source": "llm"}, {"id": "U44", "start_ms": 208591, "end_ms": 215243, "word_start": 436, "word_end": 453, "text": "One more thing, my neighbour gave me some hydrazine tablets for itching, I took 2 of them.", "role": "patient", "role_confidence": 0.95, "phase": "history", "flags": [], "role_source": "llm"}, {"id": "U45", "start_ms": 216184, "end_ms": 221494, "word_start": 453, "word_end": 466, "text": "Please stop those tablets, and do not take any medicine without asking me.", "role": "doctor", "role_confidence": 0.96, "phase": "plan", "flags": [], "role_source": "llm"}, {"id": "U46", "start_ms": 222172, "end_ms": 225332, "word_start": 466, "word_end": 474, "text": "My receptionist will give you the lab slip.", "role": "doctor", "role_confidence": 0.94, "phase": "admin", "flags": [], "role_source": "llm"}, {"id": "U47", "start_ms": 226147, "end_ms": 228101, "word_start": 474, "word_end": 479, "text": "Thank you doctor thank you", "role": "patient", "role_confidence": 0.9, "phase": "admin", "flags": [], "role_source": "llm"}, {"id": "U48", "start_ms": 231381, "end_ms": 233943, "word_start": 479, "word_end": 486, "text": "Take care, Mr. Kumar. Get well soon.", "role": "doctor", "role_confidence": 0.95, "phase": "small_talk", "flags": [], "role_source": "llm"}], "excluded_ids": ["U01", "U02", "U03", "U48"], "flags": []}, "provenance": [{"stage": "roles", "role": "GENERATOR", "provider": "demo", "model": "demo-fixture", "prompt_version": "roles-v3", "cache": "fixture", "attempts": 0, "latency_ms": 0}], "at": "2026-10-21T03:22:53+00:00"}
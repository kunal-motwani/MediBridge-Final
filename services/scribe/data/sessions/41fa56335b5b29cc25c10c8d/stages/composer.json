{"output": {"sentences": [{"id": "S01", "section": "subjective", "text": "Cough for about two weeks with fever at night.", "assertion_ids": ["A01", "A02"], "kind": "fact", "edited": false, "warnings": []}, {"id": "S02", "section": "subjective", "text": "Cough productive of yellow sputum.", "assertion_ids": ["A03"], "kind": "fact", "edited": false, "warnings": []}, {"id": "S03", "section": "subjective", "text": "Breathless on climbing stairs; no chest pain and no blood in the phlegm.", "assertion_ids": ["A05", "A04", "A06"], "kind": "fact", "edited": false, "warnings": []}, {"id": "S04", "section": "subjective", "text": "Single home temperature reading of 100.8.", "assertion_ids": ["A07"], "kind": "fact", "edited": false, "warnings": []}, {"id": "S05", "section": "subjective", "text": "Stopped metformin last week because of stomach upset.", "assertion_ids": ["A08", "A09"], "kind": "fact", "edited": false, "warnings": []}, {"id": "S06", "section": "subjective", "text": "Continues amlodipine every morning.", "assertion_ids": ["A10"], "kind": "fact", "edited": false, "warnings": []}, {"id": "S07", "section": "subjective", "text": "Allergic to penicillin (rash all over the body).", "assertion_ids": ["A11"], "kind": "fact", "edited": false, "warnings": []}, {"id": "S08", "section": "subjective", "text": "Former smoker, quit 5 years ago; no alcohol.", "assertion_ids": ["A14", "A15"], "kind": "fact", "edited": false, "warnings": []}, {"id": "S09", "section": "family_history", "text": "Mother had diabetes; father had a heart attack at age 60.", "assertion_ids": ["A12", "A13"], "kind": "fact", "edited": false, "warnings": []}, {"id": "S10", "section": "objective", "text": "Crackles heard at the right lower lung base.", "assertion_ids": ["A16"], "kind": "fact", "edited": false, "warnings": []}, {"id": "S11", "section": "objective", "text": "Blood pressure 138/88.", "assertion_ids": ["A18"], "kind": "fact", "edited": false, "warnings": []}, {"id": "S12", "section": "objective", "text": "Temperature 99.4; oxygen saturation 96%.", "assertion_ids": ["A17", "A19"], "kind": "fact", "edited": false, "warnings": []}, {"id": "S13", "section": "assessment", "text": "Chest infection, possibly early right-sided pneumonia (clinician's impression, uncertain).", "assertion_ids": ["A20"], "kind": "fact", "edited": false, "warnings": []}, {"id": "S14", "section": "plan", "text": "Amoxicillin not given because of the penicillin allergy.", "assertion_ids": ["A21", "A11"], "kind": "fact", "edited": false, "warnings": []}, {"id": "S15", "section": "plan", "text": "Start azithromycin 500 mg once daily for 5 days, after food.", "assertion_ids": ["A22"], "kind": "fact", "edited": false, "warnings": []}, {"id": "S16", "section": "plan", "text": "Advised conditionally: if fever goes above 102, paracetamol 650 mg, not more than 3 times a day.", "assertion_ids": ["A23"], "kind": "fact", "edited": false, "warnings": []}, {"id": "S17", "section": "plan", "text": "Switch to metformin extended release 500 mg once daily with dinner.", "assertion_ids": ["A27"], "kind": "fact", "edited": false, "warnings": []}, {"id": "S18", "section": "plan", "text": "Chest X-ray and complete blood count today; HbA1c test.", "assertion_ids": ["A24", "A25", "A26"], "kind": "fact", "edited": false, "warnings": []}, {"id": "S19", "section": "plan", "text": "Took 2 'hydrazine' tablets (name unclear) from a neighbour for itching; advised to stop them and not to take medicines without asking.", "assertion_ids": ["A33", "A34", "A35"], "kind": "fact", "edited": false, "warnings": []}, {"id": "S20", "section": "plan", "text": "Warm fluids and rest; rest for 2 days before returning to the office; avoid sweets and sugary drinks.", "assertion_ids": ["A28", "A31", "A32"], "kind": "fact", "edited": false, "warnings": []}, {"id": "S21", "section": "plan", "text": "Advised conditionally: return immediately or go to the emergency if very breathless or if the fever does not come down in 3 days.", "asserti